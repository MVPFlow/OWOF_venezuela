{
  "name": "@owofvzla/db",
  "version": "0.1.0",
  "private": true,
  "description": "OWOFVzla Database package - Drizzle ORM schema, migrations, and seeds",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "generate": "drizzle-kit generate:pg",
    "migrate": "drizzle-kit push:pg",
    "seed": "tsx src/seed.ts",
    "studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.43.1",
    "postgres": "^3.4.5",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.30.6",
    "tsx": "^4.19.4",
    "typescript": "^6.0.3"
  }
}
